# Claude credentials (required for real answers). Never commit a real key.
ANTHROPIC_API_KEY=

# Service
PORT=4100
NODE_ENV=development
LOG_LEVEL=info

# Model settings (defaults shown)
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_TOKENS=16000
ASSISTANT_MAX_TOOL_ROUNDS=8
ASSISTANT_REQUEST_TIMEOUT_MS=120000
# Server-side refusal fallback. Set false on Bedrock / Vertex / Foundry.
ASSISTANT_ENABLE_FALLBACKS=true

# PriceWise API. Leave empty to run on the bundled sample catalogue.
PRICEWISE_API_URL=http://localhost:4000
PRICEWISE_API_TIMEOUT_MS=8000

# Security
# When set, callers must send header x-assistant-key with this value (min 16 chars).
ASSISTANT_SHARED_SECRET=
# Comma-separated browser origins allowed to call the chat endpoint directly.
CORS_ALLOWED_ORIGINS=
# true only behind your own proxy that sets X-Forwarded-For (used for per-shopper rate limits).
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_CHATS=64
SERVE_DEMO_UI=true
