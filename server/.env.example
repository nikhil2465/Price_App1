# Copy to .env and fill in. Never commit real credentials.
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser (production).
CORS_ORIGINS=http://localhost:5173
# Where the AI assistant service runs. /api/assistant/* is proxied here.
ASSISTANT_URL=http://localhost:4100
# How long live marketplace responses are cached, in seconds.
OFFER_CACHE_TTL_SECONDS=900

# Amazon Product Advertising API 5.0 (Amazon Associates India). Leave blank to use sample data.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

# Flipkart Affiliate API. Leave blank to use sample data.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
